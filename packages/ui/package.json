{
  "name": "@inkup/ui",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "The shared UI: shadcn/ui primitives, the DESIGN.md theme and mountInShadow, for the extension and the desktop app.",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./mount-in-shadow": "./src/mount-in-shadow.ts",
    "./comment-box": "./src/comment-box/index.ts",
    "./toolbar": "./src/toolbar/index.ts",
    "./toolbar-state": "./src/toolbar-state.ts",
    "./theme.css": "./src/styles/theme.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@inkup/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
