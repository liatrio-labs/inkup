{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inkup.dev/schema/host-control.schema.json",
  "title": "inkup host control API",
  "description": "Control API version 2 (host.json and /api/host/*). Generated from packages/protocol/src/host-control.ts by `pnpm schema`; do not edit.",
  "definitions": {
    "HostFile": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "$ref": "#/definitions/HostKind"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "control_token": {
          "type": "string",
          "minLength": 1,
          "description": "the Bearer token /api/host/* takes"
        },
        "control_api": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "the control API version the holder speaks; a number, not a literal, so a client of another version can read it and say so"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "the holder's release, e.g. \"0.1.0\""
        },
        "started_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "epoch ms"
        }
      },
      "required": [
        "pid",
        "kind",
        "port",
        "control_token",
        "control_api",
        "version",
        "started_at"
      ],
      "description": "host.json in the data dir, written by the Host holding host.lock once its server has bound"
    },
    "ControlState": {
      "type": "object",
      "properties": {
        "control_api": {
          "type": "integer",
          "enum": [
            2
          ]
        },
        "kind": {
          "$ref": "#/definitions/HostKind"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "description": "127.0.0.1:<port>"
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/definitions/NetworkView"
            },
            {
              "type": "null"
            }
          ],
          "description": "set in network mode"
        },
        "update": {
          "description": "a newer release, once the background check finds one",
          "type": [
            "string",
            "null"
          ]
        },
        "network_switch": {
          "type": "boolean",
          "description": "whether POST /api/host/network can switch network mode on this Host"
        },
        "pending_pairing": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PairingPrompt"
          },
          "description": "pairing requests this Host asks about through the control API; empty when its terminal asks"
        },
        "state": {
          "$ref": "#/definitions/HostState"
        }
      },
      "required": [
        "control_api",
        "kind",
        "version",
        "address",
        "network",
        "update",
        "network_switch",
        "pending_pairing",
        "state"
      ],
      "description": "GET /api/host/state?timeline=<session id>"
    },
    "Activated": {
      "type": "object",
      "properties": {
        "handled": {
          "type": "boolean",
          "description": "false when the Host has no window to bring forward (the TUI, serve)"
        }
      },
      "required": [
        "handled"
      ],
      "description": "POST /api/host/activate"
    },
    "HostKind": {
      "type": "string",
      "enum": [
        "tui",
        "serve",
        "desktop"
      ],
      "description": "which kind of Host holds the data dir"
    },
    "HostState": {
      "type": "object",
      "properties": {
        "clients": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClientView"
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SessionOverview"
          },
          "description": "most recently updated first"
        },
        "timeline": {
          "anyOf": [
            {
              "$ref": "#/definitions/Timeline"
            },
            {
              "type": "null"
            }
          ],
          "description": "of the Session asked for, else of the newest live Session"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemView"
          }
        },
        "watchers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Watcher"
          }
        },
        "agent_tokens": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AgentToken"
          }
        }
      },
      "required": [
        "clients",
        "sessions",
        "timeline",
        "items",
        "watchers",
        "agent_tokens"
      ],
      "description": "what the TUI shows (inkup_server::HostState)"
    },
    "ClientView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        },
        "created_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "epoch ms"
        },
        "last_seen_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "epoch ms"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "connected",
        "created_at",
        "last_seen_at"
      ]
    },
    "SessionOverview": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "t0": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "epoch ms"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "epoch ms"
        },
        "updated_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "epoch ms"
        },
        "live": {
          "type": "boolean",
          "description": "no session_end yet"
        },
        "paused": {
          "type": "boolean",
          "description": "live, and its latest pause is not followed by a resume"
        },
        "items": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "current Change Items"
        },
        "open_items": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "current Change Items with no Resolution"
        },
        "annotations": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "draft_items": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "client_id",
        "url",
        "title",
        "t0",
        "created_at",
        "updated_at",
        "live",
        "paused",
        "items",
        "open_items",
        "annotations",
        "draft_items"
      ]
    },
    "Timeline": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelineEntry"
          }
        }
      },
      "required": [
        "session_id",
        "entries"
      ]
    },
    "TimelineEntry": {
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "ms since the Session t0"
        },
        "kind": {
          "type": "string",
          "description": "said, annotation, command, draft, comment or session"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "kind",
        "text"
      ]
    },
    "ItemStatus": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "wont_fix",
        "needs_info"
      ]
    },
    "ItemView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "item-<seq>, as agents see it"
        },
        "session_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ItemStatus"
        },
        "note": {
          "description": "the latest resolution's note",
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "description": "the agent behind the latest resolution",
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "epoch ms"
            },
            {
              "type": "null"
            }
          ],
          "description": "when the latest resolution was made"
        },
        "prompt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "session_id",
        "title",
        "category",
        "status",
        "note",
        "agent",
        "since",
        "prompt"
      ]
    },
    "Watcher": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "epoch ms"
        }
      },
      "required": [
        "id",
        "url",
        "session_id",
        "since"
      ],
      "description": "an agent blocked in watch_items"
    },
    "AgentToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "epoch ms"
        },
        "last_used_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "epoch ms"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "created_at",
        "last_used_at"
      ],
      "description": "an agent token not revoked; never its secret"
    },
    "NetworkView": {
      "type": "object",
      "properties": {
        "claimed": {
          "description": "the .local name, once claimed on mDNS",
          "type": [
            "string",
            "null"
          ]
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "this machine's LAN addresses"
        },
        "base_url": {
          "type": "string",
          "description": "where another machine reaches the Host"
        }
      },
      "required": [
        "claimed",
        "addresses",
        "base_url"
      ],
      "description": "network mode as the header shows it"
    },
    "PairingPrompt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "answer it at POST /api/host/pairing/{id}"
        },
        "prompt": {
          "type": "string",
          "description": "\"Chrome extension \"Work laptop\" wants to connect\""
        },
        "client_kind": {
          "type": "string"
        },
        "client_name": {
          "type": "string"
        },
        "remote": {
          "anyOf": [
            {
              "$ref": "#/definitions/RemotePairing"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "prompt",
        "client_kind",
        "client_name",
        "remote"
      ],
      "description": "a pairing request waiting for the user"
    },
    "RemotePairing": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$",
          "description": "the 6-digit code the user types in the Client"
        },
        "from": {
          "type": "string",
          "description": "the address the request came from"
        },
        "link": {
          "type": "string",
          "description": "inkup://pair?url=…&code=…, for a QR code"
        }
      },
      "required": [
        "code",
        "from",
        "link"
      ],
      "description": "a pairing request from another machine (network mode): shown, not approved"
    },
    "Changes": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "pass it back as `since` to wait for the next change"
        }
      },
      "required": [
        "seq"
      ],
      "description": "GET /api/host/changes?since=<seq>: answered at the next change, or after a while with no change"
    },
    "HostCommand": {
      "type": "string",
      "enum": [
        "start_session",
        "pause",
        "resume",
        "stop",
        "set_draw_mode"
      ]
    },
    "CommandRequest": {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "$ref": "#/definitions/HostCommand"
        },
        "draw_mode": {
          "description": "set_draw_mode only: on or off",
          "type": "boolean"
        }
      },
      "required": [
        "client_id",
        "command"
      ],
      "description": "POST /api/host/commands: what the TUI's keys do to a connected Client's Session"
    },
    "CommandOutcome": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ok",
        "session_id",
        "message"
      ],
      "description": "the Client's answer to a command"
    },
    "NewTokenRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "who it is for, e.g. \"claude-code on laptop\""
        }
      },
      "required": [
        "name"
      ],
      "description": "POST /api/host/tokens"
    },
    "NewToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "epoch ms"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "the secret: shown once, stored nowhere but by its user"
        }
      },
      "required": [
        "id",
        "name",
        "created_at",
        "token"
      ],
      "description": "a new agent token"
    },
    "NetworkRequest": {
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        }
      },
      "required": [
        "on"
      ],
      "description": "POST /api/host/network"
    },
    "NetworkSwitched": {
      "type": "object",
      "properties": {
        "handled": {
          "type": "boolean",
          "description": "false when this Host switches network mode in its own terminal"
        }
      },
      "required": [
        "handled"
      ],
      "description": "the Host restarts its server in the new mode after answering"
    },
    "PairingAnswer": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "deny"
          ]
        }
      },
      "required": [
        "decision"
      ],
      "description": "POST /api/host/pairing/{id}; a request from another machine can only be denied"
    }
  }
}
