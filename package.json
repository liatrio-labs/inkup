{
  "name": "inkup-workspace",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Workspace root: packages/core (@inkup/core), extensions/web (the WXT browser extension), apps/desktop (the Tauri desktop app), repo-level scripts and e2e.",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "pnpm -C extensions/web dev",
    "build": "pnpm -C extensions/web build",
    "build:safari": "pnpm -C extensions/web build:safari",
    "safari:xcode": "pnpm -C extensions/web safari:xcode",
    "build:firefox": "pnpm -C extensions/web build:firefox",
    "zip": "pnpm -C extensions/web zip",
    "zip:firefox": "pnpm -C extensions/web zip:firefox",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:e2e": "pnpm build && pnpm host:build && playwright test --project=chrome",
    "host:build": "cargo build --quiet --manifest-path host/Cargo.toml -p inkup",
    "desktop:dev": "pnpm -C apps/desktop dev",
    "desktop:build": "pnpm -C apps/desktop build",
    "test:e2e:firefox": "pnpm build:firefox && playwright test --project=firefox",
    "icons": "bash scripts/gen-icons.sh",
    "fixtures:serve": "node scripts/serve-fixtures.ts",
    "fixtures:audio": "bash scripts/gen-fixture-audio.sh",
    "fixtures:react": "node scripts/vendor-react-fixture.ts",
    "assets:copy": "pnpm -C extensions/web assets:copy",
    "schema": "node scripts/gen-schema.ts && pnpm -C packages/protocol schema",
    "validate:session": "node scripts/validate-session.ts",
    "metrics": "node scripts/metrics.ts",
    "fixtures:sessions": "node scripts/gen-session-fixtures.ts",
    "fixtures:long": "node scripts/gen-long-session.ts",
    "eval": "pnpm -C extensions/web eval",
    "eval:stt": "pnpm -C extensions/web eval:stt",
    "test:e2e:whisper": "pnpm build && playwright test --config playwright.whisper.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
