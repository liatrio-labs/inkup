{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "chrome",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@@/*": [
        "./*"
      ]
    }
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src",
    "tests",
    "scripts",
    "*.config.ts"
  ]
}
