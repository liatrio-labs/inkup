{
  "name": "inkup",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Record a spoken, drawn-on review of a web page and turn it into located Change Items.",
  "scripts": {
    "dev": "pnpm assets:copy && wxt",
    "build": "pnpm assets:copy && wxt build",
    "build:safari": "pnpm assets:copy && wxt build -b safari --mv3",
    "safari:xcode": "bash scripts/safari-xcode.sh",
    "zip": "pnpm assets:copy && wxt zip",
    "postinstall": "wxt prepare && node scripts/copy-wasm-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:copy": "node scripts/copy-wasm-assets.mjs",
    "eval": "vitest run --config vitest.eval.config.ts process combine",
    "eval:stt": "vitest run --config vitest.eval.config.ts stt",
    "build:firefox": "pnpm assets:copy && wxt build -b firefox --mv3",
    "zip:firefox": "pnpm assets:copy && wxt zip -b firefox --mv3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@deepgram/sdk": "5.12.0",
    "@dnd-kit/react": "^0.5.0",
    "@elevenlabs/client": "1.25.0",
    "@huggingface/transformers": "^4.3.0",
    "@ricky0123/vad-web": "^0.0.31",
    "@inkup/core": "workspace:*",
    "@inkup/protocol": "workspace:*",
    "@webext-core/messaging": "^4.0.0",
    "@wxt-dev/storage": "^1.2.9",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.1",
    "clsx": "^2.1.1",
    "css-selector-generator": "^3.9.4",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "dom-accessibility-api": "^0.7.1",
    "fix-webm-duration": "^1.0.6",
    "lucide-react": "^1.47.0",
    "onnxruntime-web": "^1.30.0",
    "p-limit": "^7.3.3",
    "perfect-freehand": "^1.2.3",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-ebml": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
