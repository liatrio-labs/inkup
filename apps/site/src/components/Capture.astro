---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A real product capture from the capture pipeline (tests/e2e/site-captures.spec.ts writes them to
// src/assets/captures). A video capture wins over a still; with neither, the slot shows its fallback, an illustration
// that labels itself as one.
interface Props {
  name: string;
  alt: string;
  class?: string;
}
const { name, alt, class: className } = Astro.props;

const stills = import.meta.glob<{ default: ImageMetadata }>('../assets/captures/*.{png,jpg,webp}', { eager: true });
const videos = import.meta.glob<string>('../assets/captures/*.{mp4,webm}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const find = <T,>(files: Record<string, T>, ext: string) => files[`../assets/captures/${name}.${ext}`];

const mp4 = find(videos, 'mp4');
const webm = find(videos, 'webm');
const poster = find(stills, 'jpg') ?? find(stills, 'png');
const still = find(stills, 'png') ?? find(stills, 'webp') ?? find(stills, 'jpg');
---

<div class:list={['capture', className]}>
  {
    mp4 || webm ? (
      <video
        muted
        playsinline
        loop
        preload="none"
        data-autoplay
        poster={poster?.default.src}
        aria-label={alt}
        width={poster?.default.width}
        height={poster?.default.height}
      >
        {webm && <source src={webm} type="video/webm" />}
        {mp4 && <source src={mp4} type="video/mp4" />}
      </video>
    ) : still ? (
      <Image src={still.default} alt={alt} widths={[720, 1080, 1440]} sizes="(min-width: 72rem) 50rem, 100vw" />
    ) : (
      <slot />
    )
  }
</div>

<style>
  .capture {
    border-radius: var(--radius-l);
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--paper-2);
    box-shadow: var(--shadow-card);
  }

  .capture :global(img),
  .capture video {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
