---
// A shell command with a copy button. The copy is a conversion (Umami event), so each command names its event.
interface Props {
  command: string;
  event: string;
  label: string;
  class?: string;
}
const { command, event, label, class: className } = Astro.props;
// A long command wraps between words, never inside one (a hyphen in `liatrio-labs` is not a place to break).
const words = command.split(' ');
---

<div class:list={['copy', className]}>
  <pre><code><span class="prompt" aria-hidden="true">$ </span>{words.map((word, i) => [i > 0 ? ' ' : '', <span class="word">{word}</span>])}</code></pre>
  <button
    type="button"
    class="copy-button"
    data-copy={command}
    data-umami-event={event}
    aria-label={`Copy ${label}`}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"
      ></path></svg
    >
    <span data-copy-label>Copy</span>
  </button>
</div>

<style>
  .copy {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border-radius: var(--radius-m);
    background: var(--paper-2);
    border: 1px solid var(--hairline);
    max-width: 100%;
  }

  pre {
    margin: 0;
    flex: 1;
    min-width: 0;
    white-space: pre-wrap;
    overflow-x: auto;
    font-size: var(--step--1);
  }

  .word {
    white-space: nowrap;
  }

  .prompt {
    color: var(--muted);
    user-select: none;
  }

  .copy-button {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-s);
    background: var(--paper);
    color: var(--ink);
    font: 600 var(--step--1) / 1 var(--font-sans);
    cursor: pointer;
  }

  .copy-button:hover {
    border-color: var(--ink-2);
  }

  .copy-button svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .copy-button.copied {
    color: var(--done);
    border-color: currentColor;
  }
</style>
