---
import type { ReviewItem } from '../review.ts';

// One Change Item, as the review page shows it: what should change, where, and what was said.
interface Props {
  item: ReviewItem;
  class?: string;
  compact?: boolean;
}
const { item, class: className, compact = false } = Astro.props;
---

<article class:list={['item', { compact }, className]} data-item={item.id} data-status="open">
  <header>
    <h3 class="title">{item.title}</h3>
    <span class="status" data-status-label>Open</span>
  </header>
  <dl>
    <div>
      <dt class="visually-hidden">Element</dt>
      <dd class="selector code">{item.selector}</dd>
    </div>
    <div>
      <dt class="visually-hidden">Said at</dt>
      <dd class="at code">{item.at}</dd>
    </div>
  </dl>
  {!compact && <blockquote class="quote">“{item.quote}”</blockquote>}
  <p class="resolution" data-resolution hidden></p>
</article>

<style>
  .item {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border-radius: var(--radius-m);
    background: var(--paper);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-card);
    font-size: var(--step--1);
  }

  header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .title {
    font-size: 1rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-weight: 650;
  }

  .status {
    flex: none;
    padding: 0.15em 0.55em;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.4;
    font-weight: 600;
  }

  [data-status='working'] .status {
    color: var(--working);
    border-color: currentColor;
  }

  [data-status='done'] .status {
    color: var(--done);
    border-color: currentColor;
  }

  dl {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  .selector {
    color: var(--pen-ink);
  }

  .quote {
    margin: 0;
    padding-left: var(--space-3);
    border-left: 1px solid var(--pen);
    color: var(--ink-2);
  }

  .resolution {
    color: var(--muted);
  }

  .compact {
    padding: var(--space-3) var(--space-4);
    gap: var(--space-1);
  }

  .compact .title {
    font-size: 0.9rem;
  }
</style>
