---
import { items } from '../review.ts';
import ChangeItem from './ChangeItem.astro';

// The side panel of a review in progress: the Change Items made so far on this page. Server-rendered with every item,
// so it reads complete without JS; the review script holds back the items whose section hasn't been reached yet.
---

<aside class="dock" aria-labelledby="dock-title" data-dock>
  <div class="dock-inner">
    <div class="dock-head">
      <h2 id="dock-title">Change Items</h2>
      <span class="count" data-count aria-live="polite">{items.length}</span>
    </div>
    <p class="dock-note">An example review of this page</p>
    <ol class="dock-list">
      {
        items.map((item, index) => (
          <li data-dock-item={item.id} data-section={item.section} data-ends={item.ends}>
            <ChangeItem item={item} compact={index > 0} />
          </li>
        ))
      }
    </ol>
  </div>
</aside>

<style>
  .dock {
    display: none;
  }

  @media (min-width: 72rem) {
    .dock {
      display: block;
      position: relative;
    }

    .dock-inner {
      position: sticky;
      top: 5.5rem;
      padding: var(--space-1) 0 var(--space-4) var(--space-5);
      border-left: 1px solid var(--hairline);
      background: var(--paper);
      max-height: calc(100vh - 7rem);
      overflow: auto;
      overscroll-behavior: contain;
    }
  }

  .dock-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  h2 {
    font-size: var(--step-0);
    letter-spacing: -0.01em;
  }

  .count {
    min-width: 1.6rem;
    padding: 0.1em 0.5em;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    font: 600 0.8rem / 1.4 var(--font-sans);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .dock-note {
    margin-top: var(--space-1);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .dock-list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* With JS, an item waits in the dock until its section is reviewed. */
    :global(.js) .dock-list > li:not(.arrived) {
      display: none;
    }

    .dock-list > li.arrived {
      animation: snap-in 520ms var(--ease-out) both;
    }

    .dock-list > li.arrived > :global(.item) {
      animation: lift 900ms var(--ease-out) both;
    }
  }

  @keyframes snap-in {
    from {
      opacity: 0;
      translate: 18px 0;
      scale: 0.98;
    }
  }

  @keyframes lift {
    0% {
      box-shadow: var(--shadow-lift);
      border-color: var(--pen);
    }
    100% {
      box-shadow: var(--shadow-card);
    }
  }
</style>
