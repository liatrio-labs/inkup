---
import Capture from '../components/Capture.astro';
import ChangeItem from '../components/ChangeItem.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Inspect from '../components/Inspect.astro';
import ItemsDock from '../components/ItemsDock.astro';
import Mark from '../components/Mark.astro';
import PenLoop from '../components/PenLoop.astro';
import SyntheticFrame from '../components/SyntheticFrame.astro';
import liatrioLogo from '../assets/liatrio/logo_Liatrio.svg';
import liatrioReverse from '../assets/liatrio/logo_Liatrio_reverse-preferred.svg';
import Base from '../layouts/Base.astro';
import { chromeStore, commands, installLabel, links, versions } from '../releases.ts';
import { itemFor, items } from '../review.ts';

const title = 'InkUp: review your site out loud';
const description =
  'Talk and draw on any web page. InkUp turns what you say and point at into located Change Items that you, or your coding agent, can act on.';
const heroItem = itemFor('top')!;
const year = new Date().getFullYear();
---

<Base title={title} description={description}>
  <header class="nav" data-nav>
    <div class="nav-inner">
      <a class="brand" href="#top" aria-label="InkUp home">
        <Mark size={30} />
        <span class="wordmark">InkUp</span>
      </a>
      <nav aria-label="Sections">
        <ul>
          <li><a href="#how">How it works</a></li>
          <li><a href="#agents">Agents</a></li>
          <li><a href="#privacy">Privacy</a></li>
          <li><a href="#source">Open source</a></li>
          <li>
            <a href={links.repo} data-umami-event="github" data-umami-event-location="nav">GitHub</a>
          </li>
        </ul>
      </nav>
      <a
        class="button primary small"
        href={links.chrome}
        data-umami-event="install-chrome"
        data-umami-event-location="nav">{installLabel}</a
      >
    </div>
  </header>

  <div class="layout">
    <main id="main">
      <section class="hero" id="top" data-section="top" data-ink>
        <Inspect selector="h1" class="hero-title-box">
          <h1 class="hero-title">Review your site out loud.</h1>
        </Inspect>
        <p class="hero-lede">
          Talk and draw on any web page. InkUp turns what you say and point at into located Change Items that you, or
          your coding agent, can act on.
        </p>
        <div class="hero-actions">
          <span class="cta-wrap">
            <a
              class="button primary cta"
              href={links.chrome}
              data-umami-event="install-chrome"
              data-umami-event-location="hero"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  d="M12 5v11m0 0-4.5-4.5M12 16l4.5-4.5M5 19h14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
              {installLabel}
            </a>
            <PenLoop />
          </span>
          <a class="button" href="#how">See how it works</a>
          <p class="said" aria-hidden="true">
            <span class="said-at code">{heroItem.at}</span>
            <span>“{heroItem.quote}”</span>
          </p>
        </div>
        <p class="hero-meta">
          Free, open source and fully auditable. No account. Sessions stay in your browser.{
            !chromeStore && ' The Chrome Web Store listing is in review; install from GitHub in a minute.'
          }
        </p>
        <ChangeItem item={heroItem} class="inline-item" />
      </section>

      <section class="section demo-section" id="demo" data-section="demo" data-ink>
        <h2>Watch a review turn into Change Items.</h2>
        <p class="lede">
          Circle the thing, say what's wrong, keep going. When you stop, every note comes back as an item that names its
          element, carries a screenshot and the words you used.
        </p>
        <Inspect selector="figure.demo" class="demo-box" tagAt="top">
          <figure class="demo">
            <Capture name="review-flow" alt="A recorded InkUp review: drawing on a page, then the Change Items it produced.">
              <SyntheticFrame />
            </Capture>
          </figure>
        </Inspect>
        <ChangeItem item={itemFor('demo')!} class="inline-item" />
      </section>

      <section class="section" id="how" data-section="how" data-ink>
        <h2>Three steps from talking to done.</h2>
        <Inspect selector="ol.steps" class="steps-box">
          <ol class="steps">
            <li>
              <h3>Talk and draw</h3>
              <p>
                Click the icon or press <kbd>Alt</kbd>+<kbd>Shift</kbd>+<kbd>R</kbd>. Say what's wrong and draw on the
                page. InkUp records your voice, the tab, a live transcript, and each Stroke with the elements under it.
              </p>
            </li>
            <li>
              <h3>Process</h3>
              <p>
                Press Stop. The review page sends a text script of the Session to Claude with your own key, and gets
                back Change Items. Edit, reorder or delete them.
              </p>
            </li>
            <li>
              <h3>Hand off</h3>
              <p>
                Export a zip with <code>session.json</code>, the screenshots and an agent prompt. Or pair the InkUp host
                and let your coding agent pick the items up over MCP.
              </p>
            </li>
          </ol>
        </Inspect>
        <ChangeItem item={itemFor('how')!} class="inline-item" />
      </section>

      <section class="section" id="what" data-section="what">
        <h2>Say “this”, and InkUp knows which one.</h2>
        <p class="lede">Everything you say lands on an element, like a node in the inspector.</p>
        <ul class="tree" role="list">
          <li>
            <details open>
              <summary>“This” and “here” resolve to elements</summary>
              <p>
                Spoken references land on the element you were drawing on or pointing at, so every item says where, not
                just what.
              </p>
            </details>
          </li>
          <li>
            <details>
              <summary>Pick exactly, when a circle is too loose</summary>
              <p>Object Select picks one element. Select Text comments on the words you highlight.</p>
            </details>
          </li>
          <li>
            <details>
              <summary>Voice Commands, hands on the mouse</summary>
              <p>
                Say “scratch that”, “next”, “pin that”, “snap”, “pause” or “resume” without leaving the page.
              </p>
            </details>
          </li>
          <li>
            <details>
              <summary>Draft Items while you talk</summary>
              <p>With an Anthropic key, items start appearing in the side panel before you press Stop.</p>
            </details>
          </li>
          <li>
            <details>
              <summary>Phone, tablet and desktop sizes</summary>
              <p>Resize the page to a preset viewport mid-review. Each item records the size it was made at.</p>
            </details>
          </li>
          <li>
            <details>
              <summary>From element to source</summary>
              <p>
                Source mapping names the component that rendered an element, and your app can add review notes of its
                own through <code>window.__inkup</code>.
              </p>
            </details>
          </li>
        </ul>
      </section>

      <section class="section" id="privacy" data-section="privacy" data-ink>
        <h2>Private until you add a key.</h2>
        <Inspect selector="p.promise" class="promise-box">
          <p class="promise">
            On the free tier, transcription runs on your device and nothing is sent anywhere.
            <PenLoop />
          </p>
        </Inspect>
        <ul class="facts">
          <li>Sessions stay in your browser's storage until you delete them.</li>
          <li>No backend, no account, no sign-in.</li>
          <li>
            Add your own Deepgram or ElevenLabs key for better transcription, and an Anthropic key for Process and Draft
            Items.
          </li>
          <li>Pair a host only when you want agents in the loop.</li>
          <li>Don't take our word for it: <a href="#source">read the code</a>.</li>
        </ul>
        <ChangeItem item={itemFor('privacy')!} class="inline-item" />
      </section>

      <section class="section oss" id="source">
        <h2>Open source. Audit every line.</h2>
        <p class="lede">
          InkUp is MIT licensed and fully auditable. The extension, the host and the desktop app live in one public
          repository, so you can check exactly what gets recorded and where it goes.
        </p>
        <ul class="facts">
          <li>Every release is built by public GitHub Actions workflows from a tagged commit on main.</li>
          <li>The Firefox build is checked to rebuild the same add-on from its sources.</li>
          <li>The decisions behind the design are written down as architecture decision records.</li>
          <li>Issues, fixes and pull requests are welcome.</li>
        </ul>
        <div class="oss-actions">
          <a class="button primary" href={links.repo} data-umami-event="github" data-umami-event-location="oss">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.4 18.3 4.7 18.3 4.7c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z"
              ></path></svg
            >
            liatrio-labs/inkup
          </a>
          <a class="text-link" href={links.adrs}>Architecture decisions</a>
          <a class="text-link" href={links.contributing}>Contributing</a>
        </div>
      </section>
      <section class="section install" id="install" data-section="install" data-ink>
        <h2>Start reviewing.</h2>
        <div class="install-rows">
          <div class="install-row lead">
            <div>
              <h3>Browser extension</h3>
              <p>Works on its own. Version {versions.extension}.</p>
              {
                !chromeStore && (
                  <p class="pending">
                    The Chrome Web Store listing is in review. Until it's live, install the release build by hand: it
                    takes a minute.
                  </p>
                )
              }
            </div>
            {
              chromeStore ? (
                <div class="install-actions">
                  <a
                    class="button primary"
                    href={chromeStore}
                    data-umami-event="install-chrome"
                    data-umami-event-location="install"
                  >
                    Add to Chrome
                  </a>
                  <a
                    class="text-link"
                    href={links.extensionRelease}
                    data-umami-event="github"
                    data-umami-event-location="install-extension"
                  >
                    Firefox and zip builds on GitHub
                  </a>
                </div>
              ) : (
                <div class="manual">
                  <ol class="manual-steps">
                    <li>
                      <a
                        class="button primary small"
                        href={links.chromeZip}
                        data-umami-event="download-chrome-zip"
                      >
                        Download inkup-{versions.extension}-chrome.zip
                      </a>
                    </li>
                    <li>Unzip it. Keep the folder where it is: Chrome loads the extension from it.</li>
                    <li>
                      Open <code>chrome://extensions</code> and turn on <strong>Developer mode</strong>, top right.
                    </li>
                    <li>
                      Click <strong>Load unpacked</strong> and pick the unzipped folder.
                    </li>
                    <li>InkUp's onboarding tab opens and asks for the microphone. Allow it, and you're set.</li>
                  </ol>
                  <p class="manual-note">
                    Needs Chrome 153 or later. A build loaded this way doesn't update itself: unzip the next zip from{' '}
                    <a
                      href={links.extensionRelease}
                      data-umami-event="github"
                      data-umami-event-location="install-extension"
                    >
                      GitHub Releases
                    </a>
                    {' '}over the same folder and reload the extension, or switch to the store listing once it's live.
                  </p>
                  <details class="firefox">
                    <summary>Firefox</summary>
                    <p>
                      <a href={links.firefoxZip} data-umami-event="download-firefox-zip">
                        Download inkup-{versions.extension}-firefox.zip
                      </a>
                      , open <code>about:debugging</code>, choose <strong>This Firefox</strong>, then{' '}
                      <strong>Load Temporary Add-on</strong> and pick the zip. Firefox removes temporary add-ons when it
                      restarts.
                    </p>
                  </details>
                </div>
              )
            }
          </div>
          <div class="install-row">
            <div>
              <h3>InkUp host</h3>
              <p>
                The CLI and terminal UI for macOS, Linux and Windows. <a
                  href={links.host}
                  data-umami-event="github"
                  data-umami-event-location="install-host">Other installers</a
                >
              </p>
            </div>
            <Inspect selector="pre.brew" class="brew-box" tagAt="top">
              <div class="brew-wrap">
                <CopyCommand command={commands.cli} event="copy-brew-cli" label="the brew command for the CLI" />
                <PenLoop />
              </div>
            </Inspect>
          </div>
          <div class="install-row">
            <div>
              <h3>Desktop app</h3>
              <p>The same host in a window, with a menu bar icon. macOS, version {versions.host}.</p>
            </div>
            <div class="install-actions">
              <CopyCommand command={commands.cask} event="copy-brew-cask" label="the brew command for the desktop app" />
              <a class="text-link" href={links.dmg} data-umami-event="download-dmg">Download the DMG</a>
            </div>
          </div>
        </div>
        <ChangeItem item={itemFor('install')!} class="inline-item" />
      </section>

      <section class="section agents" id="agents" data-section="agents" data-agents>
        <h2>Hand the list to your coding agent.</h2>
        <p class="lede">
          Install the host's MCP server once. Claude Code, Cursor and Codex read your Change Items, claim one, and
          report back when it's done. You watch each item move from Open to In work to Done.
        </p>
        <CopyCommand command={commands.mcp} event="copy-mcp-install" label="the MCP install command" class="mcp" />
        <ol class="run" aria-label="This page's Change Items, resolved by agents">
          {
            items.map((item) => (
              <li class="run-row" data-run={item.id} data-status="open">
                <span class="run-title">{item.title}</span>
                <span class="run-agent" data-run-agent>
                  {item.agent}
                </span>
                <span class="run-status" data-run-status>
                  Open
                </span>
                <span class="run-note" data-run-note data-resolution={item.resolution} />
              </li>
            ))
          }
        </ol>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <h2 id="closing-title">Your turn. Review something.</h2>
        <div class="oss-actions">
          <a class="button primary cta" href={links.chrome} data-umami-event="install-chrome" data-umami-event-location="closing"
            >{installLabel}</a
          >
          <a class="text-link" href={links.repo} data-umami-event="github" data-umami-event-location="closing"
            >Read the source on GitHub</a
          >
        </div>
      </section>
    </main>

    <ItemsDock />
  </div>

  <footer class="footer">
    <div class="footer-inner">
      <p class="footer-brand">
        <Mark size={26} />
        <span class="footer-name">InkUp</span>
        <span class="footer-by">by</span>
        <a class="liatrio" href={links.liatrio} data-umami-event="liatrio">
          <picture>
            <source srcset={liatrioReverse.src} media="(prefers-color-scheme: dark)" />
            <img src={liatrioLogo.src} alt="Liatrio" width="68" height="24" />
          </picture>
        </a>
      </p>
      <p class="footer-meta">
        © {year} Liatrio, Inc. <a href={links.license}>MIT license</a>. Extension {versions.extension}, host{' '}
        {versions.host}.
      </p>
      <p class="footer-tip">Hold <kbd>Alt</kbd> and point at anything to inspect this page.</p>
    </div>
  </footer>
  <div class="probe" data-probe hidden aria-hidden="true">
    <span class="probe-box"></span>
    <span class="tag probe-tag"></span>
  </div>
</Base>

<script>
  import '../scripts/review.ts';
</script>

<style>
  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease-out);
  }

  :global(.scrolled) .nav {
    border-bottom-color: var(--hairline);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    max-width: 80rem;
    margin: 0 auto;
    padding: var(--space-3) var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    margin-right: auto;
  }

  .wordmark {
    font-size: 1.3rem;
    font-weight: 750;
    letter-spacing: -0.035em;
  }

  .nav ul {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    font-weight: 550;
  }

  .nav ul a {
    text-decoration: none;
    color: var(--ink-2);
  }

  .nav ul a:hover {
    color: var(--ink);
  }

  @media (max-width: 48rem) {
    .nav nav {
      display: none;
    }
  }

  /* Page grid: the page, and the Items dock beside it */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  @media (min-width: 72rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) var(--dock-w);
    }

    .layout :global(.inline-item) {
      display: none;
    }
  }

  main {
    min-width: 0;
  }

  :global(.inline-item) {
    margin-top: var(--space-6);
    max-width: 30rem;
  }

  /* Hero */
  .hero {
    padding-block: var(--space-9) var(--space-8);
  }

  :global(.hero-title-box) {
    display: inline-block;
    margin-top: var(--space-6);
  }

  .hero-title {
    font-size: var(--step-4);
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 11ch;
  }

  .hero-lede {
    margin-top: var(--space-6);
    max-width: 36ch;
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: var(--ink-2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    margin-top: var(--space-7);
  }

  .cta-wrap {
    position: relative;
    display: inline-block;
  }

  .cta {
    min-height: 3.4rem;
    padding: 0 1.6rem;
    font-size: var(--step-1);
  }

  .said {
    flex-basis: 100%;
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .said-at {
    color: var(--pen-ink);
  }

  .hero-meta {
    margin-top: var(--space-6);
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero .said {
      opacity: 0;
      translate: 0 6px;
      transition:
        opacity 400ms var(--ease-out) 900ms,
        translate 500ms var(--ease-out) 900ms;
    }

    :global(.js) .hero.is-inked .said {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* Demo */
  :global(.demo-box) {
    display: block;
    margin-top: var(--space-8);
  }

  .demo {
    margin: 0;
  }

  /* Steps: a real sequence, so it is numbered */
  :global(.steps-box) {
    display: block;
    margin-top: var(--space-8);
  }

  .steps {
    counter-reset: step;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: var(--space-2);
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .steps h3 {
    font-size: var(--step-1);
  }

  .steps p {
    color: var(--ink-2);
  }

  kbd {
    padding: 0.05em 0.4em;
    border: 1px solid var(--hairline);
    border-bottom-width: 2px;
    border-radius: 4px;
    font-size: 0.82em;
  }

  /* Capability tree: the Elements panel's disclosure rows */
  .tree {
    margin: var(--space-7) 0 0;
    padding: 0 0 0 var(--space-4);
    list-style: none;
    border-left: 1px solid var(--hairline);
    max-width: 44rem;
  }

  .tree li + li {
    margin-top: var(--space-1);
  }

  .tree summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-s);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.012em;
    cursor: pointer;
    list-style: none;
  }

  .tree summary::-webkit-details-marker {
    display: none;
  }

  .tree summary::before {
    content: '';
    flex: none;
    border-style: solid;
    border-width: 0.32em 0 0.32em 0.5em;
    border-color: transparent transparent transparent var(--muted);
    transition: rotate 180ms var(--ease-out);
  }

  .tree details[open] > summary::before {
    rotate: 90deg;
  }

  .tree summary:hover {
    background: var(--box-content);
  }

  .tree details p {
    padding: 0 var(--space-3) var(--space-4) calc(var(--space-3) * 2 + 0.5em);
    max-width: 60ch;
    color: var(--ink-2);
  }

  /* Privacy */
  :global(.promise-box) {
    display: block;
    margin-top: var(--space-8);
    max-width: 40rem;
  }

  .promise {
    position: relative;
    font-size: var(--step-2);
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 600;
  }

  .facts {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
    max-width: 40rem;
  }

  .facts li {
    padding-left: var(--space-5);
    position: relative;
    color: var(--ink-2);
  }

  .facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.6rem;
    height: 1px;
    background: var(--ink-2);
  }

  /* Install */
  .install-rows {
    margin-top: var(--space-7);
    border-top: 1px solid var(--hairline);
  }

  .install-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
