{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core events, fetch to the issue trackers' hosts only, and opening a sent item's issue in the browser (ADR 0028). Host data comes through the app's own commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/*" },
        { "url": "https://github.com/*" },
        { "url": "https://api.linear.app/*" },
        { "url": "https://uploads.linear.app/*" },
        { "url": "https://storage.googleapis.com/*" },
        { "url": "https://*.atlassian.net/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
